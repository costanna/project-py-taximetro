# Cadena de conexión de Neon (Dashboard de Neon > Connection string)
DATABASE_URL=postgresql://usuario:password@ep-xxxx.eu-central-1.aws.neon.tech/taximetro?sslmode=require

# Orígenes permitidos por CORS, separados por comas (dominio de Vercel + local)
ALLOWED_ORIGINS=http://localhost:5500,https://tu-frontend.vercel.app

# Clave para firmar los tokens de sesión. Sin esto, cada reinicio genera una
# clave aleatoria y los tokens emitidos antes dejan de ser validos.
# Genérala una vez con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-una-clave-aleatoria-larga

# Tarifas en €/segundo. Cambiarlas aquí (sin tocar código) y reiniciar el
# servicio en Render basta para aplicarlas; si se omiten, se usan 0.02/0.05.
TARIFA_PARADO=0.02
TARIFA_MOVIMIENTO=0.05
